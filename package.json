{
  "name": "saphal-stocks",
  "private": true,
  "version": "0.20.1",
  "type": "module",
  "description": "Saphal Stocks: NEPSE intelligence, AI analyst, portfolio and wealth planning for Nepal",
  "scripts": {
    "dev": "vite",
    "dev:server": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web:server\"",
    "dev:web:server": "VITE_BACKEND=server vite",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/sw-precache.mjs",
    "build:server": "tsc -p tsconfig.json --noEmit && VITE_BACKEND=server vite build",
    "export-data": "tsx scripts/export-market.ts && tsx scripts/export-live.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview --port 5180",
    "bump": "node scripts/bump.mjs",
    "deploy": "node scripts/bump.mjs && npm test && npm run typecheck && BASE_PATH=/saphal-stocks/ npm run build && node scripts/deploy.mjs",
    "serve:pages": "BASE_PATH=/saphal-stocks/ npm run build && node scripts/serve-pages.mjs 5186 /saphal-stocks/",
    "ingest": "tsx server/ingest/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "minisearch": "^7.2.0",
    "multer": "^2.5.0",
    "nepali-date-converter": "3.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.13.0",
    "unpdf": "^2.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
