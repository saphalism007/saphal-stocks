# Copy to .env (the server creates .env automatically on first run with safe defaults).
API_PORT=5181
# 64 hex chars. Encrypts sensitive profile data at rest. Generated automatically if missing.
SAPHAL_SECRET_KEY=
# AI provider: "anthropic" or "none". With "none", the analyst still produces
# deterministic, data-backed reports; only the natural-language layer is off.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Your Anthropic API key (never commit it).
ANTHROPIC_API_KEY=
# Data refresh schedule (Asia/Kathmandu). Market closes 15:00 NPT, Sun-Thu.
INGEST_DAILY_AT=15:45
